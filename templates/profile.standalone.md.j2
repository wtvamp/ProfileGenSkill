---
schema_version: 1
name: "{{ name }}"
slug: "{{ slug }}"
image: "{{ image }}"
{% if image_nsfw %}
image_nsfw: "{{ image_nsfw }}"
{% endif %}
{% if voice %}
voice: "{{ voice }}"
{% endif %}
nsfw: {{ nsfw }}
display:
  image: {{ display.image }}
  name: {{ display.name }}
  autostart: {{ display.autostart }}
  variant: {{ display.variant }}
generation:
  backend: "{{ generation.backend }}"
  model: "{{ generation.model }}"
  prompt: "{{ generation.prompt }}"
  negative_prompt: {{ generation.negative_prompt }}
  seed: {{ generation.seed }}
  gif_mode: {{ generation.gif_mode }}
  created_at: "{{ generation.created_at }}"
---

# {{ name }}

![{{ name }}]({{ image }})

{% if personality %}
## Personality

{{ personality }}
{% endif %}
