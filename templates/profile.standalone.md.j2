---
schema_version: 1
name: "{{ name }}"
slug: "{{ slug }}"
image: "{{ image }}"
{% if voice %}
voice: "{{ voice }}"
{% endif %}
nsfw: {{ nsfw }}
generation:
  backend: "{{ generation.backend }}"
  model: "{{ generation.model }}"
  prompt: "{{ generation.prompt }}"
  negative_prompt: {{ generation.negative_prompt }}
  seed: {{ generation.seed }}
  gif_mode: {{ generation.gif_mode }}
  created_at: "{{ generation.created_at }}"
---

# {{ name }}

![{{ name }}]({{ image }})

{% if personality %}
## Personality

{{ personality }}
{% endif %}
