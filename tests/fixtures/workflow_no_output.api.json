{
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": { "ckpt_name": "sd_xl_base.safetensors" },
    "_meta": { "title": "Load Checkpoint" }
  },
  "2": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "placeholder positive", "clip": ["1", 1] },
    "_meta": { "title": "ProfileGen Positive" }
  },
  "3": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "placeholder negative", "clip": ["1", 1] },
    "_meta": { "title": "ProfileGen Negative" }
  },
  "4": {
    "class_type": "EmptyLatentImage",
    "inputs": { "width": 512, "height": 512, "batch_size": 1 },
    "_meta": { "title": "ProfileGen Latent" }
  },
  "5": {
    "class_type": "KSampler",
    "inputs": {
      "seed": 0,
      "steps": 20,
      "cfg": 7.0,
      "sampler_name": "euler",
      "scheduler": "normal",
      "denoise": 1.0,
      "model": ["1", 0],
      "positive": ["2", 0],
      "negative": ["3", 0],
      "latent_image": ["4", 0]
    },
    "_meta": { "title": "KSampler" }
  }
}
